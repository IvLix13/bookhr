[Unit]
Description=Bookuchet Gunicorn Service
After=network.target postgresql.service

[Service]
Type=simple
User=bookuchet
Group=bookuchet
WorkingDirectory=/opt/bookuchet/backend
EnvironmentFile=/opt/bookuchet/.env.prod
Environment=FLASK_APP=wsgi:app
Environment=APP_ENV=production
Environment=OFFLINE_MODE=1
ExecStartPre=/opt/bookuchet/scripts/ensure-migrations.sh prod
ExecStart=/opt/bookuchet/backend/.venv/bin/gunicorn --bind 127.0.0.1:3005 --workers 3 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
